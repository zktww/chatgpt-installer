{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT 安装助手",
  "version": "1.2.0",
  "identifier": "com.github.chatgpt-installer",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "ChatGPT 安装助手",
        "width": 780,
        "height": 560,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "ChatGPT Windows 桌面版一键安装助手（官方原包直连）",
    "targets": ["nsis"]
  }
}
